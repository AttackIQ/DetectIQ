# DetectIQ Environment Configuration
# ------------------------------------
# Copy this file to .env in the project root or in the examples directory
# and replace the placeholder values with your actual credentials.
#
# ⚠️ SECURITY WARNING ⚠️
# - NEVER commit your .env file to version control
# - NEVER publish or distribute your .env file
# - NEVER include real API keys or secrets in .env.example files
# - Store your .env files locally and securely
# ------------------------------------

# ------------------------------------
# API Keys
# ------------------------------------

# OpenAI API Key (required for LLM functionality)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# ------------------------------------
# Application Settings
# ------------------------------------

# Debug mode (set to False in production)
DEBUG=False

# Django Secret Key (only needed if using the web application)
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here

# ------------------------------------
# Logging Configuration
# ------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------
# Optional Integrations
# ------------------------------------

# Splunk API settings (optional)
# SPLUNK_HOST=your-splunk-host
# SPLUNK_PORT=8089
# SPLUNK_USERNAME=your-splunk-username
# SPLUNK_PASSWORD=your-splunk-password
# SPLUNK_SCHEME=https

# ElasticSearch settings (optional)
# ELASTIC_HOST=your-elastic-host
# ELASTIC_PORT=9200
# ELASTIC_USERNAME=your-elastic-username
# ELASTIC_PASSWORD=your-elastic-password